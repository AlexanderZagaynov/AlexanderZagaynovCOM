---
import DirectionArrow from '../components/DirectionArrow.astro'
import GoogleTag from '../components/GoogleTag.astro'
import '../styles/home.css'
import '@fontsource-variable/manrope'
import '@fontsource-variable/public-sans'
import { contactEmail, githubUrl, linkedInUrl } from '../lib/links'

interface Props {
  title: string
  description: string
  schema: Record<string, unknown>[]
}
const { title, description, schema } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const path = (value: string) => `${base}${value}`
const canonical = new URL(import.meta.env.BASE_URL, Astro.site).toString()
---

<!doctype html>
<html lang="en" data-theme="dossier">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5ef" />
    {import.meta.env.PROD && <GoogleTag measurementId="G-9Y7M4XS20J" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={path('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={path('/sitemap-index.xml')} type="application/xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Alexander Zagaynov" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {schema.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="page-header page-width">
      <a class="identity" href={path('/')} aria-label="Alexander Zagaynov, home">
        <span class="identity-mark" aria-hidden="true">az.</span>
        <span>Alexander Zagaynov</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#work">Selected work</a>
        <a href="#experience">Experience</a>
        <a href={path('/cv/')}>CV <DirectionArrow /></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="page-footer page-width">
      <span>© {new Date().getFullYear()} Alexander Zagaynov</span>
      <nav aria-label="Profile and contact links">
        <a href={githubUrl}>GitHub</a>
        <a href={linkedInUrl}>LinkedIn</a>
        <a href={`mailto:${contactEmail}`}>Email</a>
      </nav>
    </footer>
  </body>
</html>
