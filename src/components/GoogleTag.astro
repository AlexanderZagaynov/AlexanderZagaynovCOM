<!--
  Google Tag Manager in Consent Mode. Analytics properties are connected inside
  the container. Until the visitor accepts analytics in the cookie banner
  (ConsentBanner.astro), every consent signal is denied: Google Analytics sets
  no cookies and sends only cookieless pings. The default must be set before
  the container loads, so it is read here from the stored choice. In
  production the container itself is served through Cloudflare's Google tag
  gateway, which injects its loader into every page of the zone.
-->
<script is:inline>
  (function (w, d, s, l, i) {
    w[l] = w[l] || [];
    // gtag() must push the arguments object itself; Consent Mode reads it.
    w.gtag = function () {
      w[l].push(arguments);
    };
    var choice = null;
    try {
      choice = w.localStorage.getItem('consent.analytics');
    } catch (error) {
      // Without storage the visitor is treated as not having chosen.
    }
    w.gtag('consent', 'default', {
      analytics_storage: choice === 'granted' ? 'granted' : 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
    });
    w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    // Cloudflare's Google tag gateway injects its own first-party loader
    // (/gtag/) ahead of this script and lists the container in
    // google_tags_first_party; loading gtm.js from Google as well would fetch
    // the container twice. Without the gateway (local preview, or gateway
    // off) the container is loaded from Google as usual.
    var firstParty = w.google_tags_first_party;
    if (firstParty && firstParty.indexOf && firstParty.indexOf(i) !== -1) {
      return;
    }
    var f = d.getElementsByTagName(s)[0],
      j = d.createElement(s),
      dl = l != 'dataLayer' ? '&l=' + l : '';
    j.async = true;
    j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
    f.parentNode.insertBefore(j, f);
  })(window, document, 'script', 'dataLayer', 'GTM-5XSQS86G');
</script>
